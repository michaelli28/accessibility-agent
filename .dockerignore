# Dependencies (will be installed fresh)
node_modules
**/node_modules

# Build outputs
dist
**/dist
build
**/build
.next
**/.next

# Environment (secrets set via fly secrets)
.env
.env.local
.env.*.local

# Git
.git
.gitignore

# Test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
logs/
transcripts/
downloads/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Temporary
tmp/
temp/

# Documentation (not needed for runtime)
*.md
!package.json

# Test website (not needed for worker)
test-website/

# Dashboard (separate deployment)
dashboard/

# Azure DevOps extension (not needed)
azure-devops-extension/

# GitLab CI (not needed)
gitlab-ci/

# Docker configs (not needed inside container, except supervisord.conf for browser-viewer)
# docker/  -- commented out to allow browser-viewer build
Dockerfile*
fly.toml

# GitHub (not needed)
.github/
